{
  "manifest_version": 3,
  "name": "Daraz Price Tracker",
  "version": "5.0.0",
  "description": "Track Daraz prices privately on your machine — price targets, comparisons, multi-currency and more.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://*.daraz.pk/*",
    "https://*.daraz.lk/*",
    "https://*.daraz.com.bd/*",
    "https://*.daraz.com.np/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.daraz.pk/*",
        "https://*.daraz.lk/*",
        "https://*.daraz.com.bd/*",
        "https://*.daraz.com.np/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Open Daraz Price Tracker",
    "default_icon": {
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
